{
  "name": "vista-oracle-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stakeable oracle node for the VISTA Trustless Attention Market.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx/esm src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/synthetic-heartbeat.ts"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.2",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "express": "^4.21.0",
    "viem": "^2.48.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
